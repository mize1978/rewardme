<!DOCTYPE html>
<html>
  <head>
    <title>RewardMe</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta property="og:title" content="RewardMe">
    <meta property="og:description" content="ごほうびでタスクを続けるアプリ🍰">
    <meta property="og:image" content="https://rewardme-qaq3.onrender.com/images/ogp.jpg">
    <meta property="og:image:type" content="image/jpeg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:url" content="https://rewardme-qaq3.onrender.com">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="RewardMe">
    <meta name="twitter:description" content="ごほうびでタスクを続けるアプリ🍰">
    <meta name="twitter:image" content="https://rewardme-qaq3.onrender.com/images/ogp.jpg">
    <link rel="icon" type="image/png" href="/favicon.png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-room-theme="<%= current_user&.current_room_bg || 'default' %>"
        data-egg-color="<%= current_user&.egg_color || 'pink' %>"
        data-coin-url="<%= asset_path('coin_ribbon.png') %>"
        data-controller="bgm"
        data-bgm-room="<%= current_user ? (current_user.current_room_bg || 'default') : 'login' %>">

    <%# 認証画面ではヘッダーを出さない。
        create を含めるのは、バリデーション失敗時に render :new でこのテンプレートを
        描画しても action_name は "create" のままで、new だけの判定では素通りし、
        ヘッダーがログインカードに重なって出てしまうため。 %>
    <% unless (controller_name == 'sessions' && %w[new create].include?(action_name)) || (controller_name == 'users' && %w[new create].include?(action_name)) || (controller_name == 'pages' && action_name == 'lp') %>
      <%= render 'shared/header' %>
    <% end %>

    <!-- you found this 😎 crafted by mize -->

    <%= yield %>

    <%= render 'shared/footer' %>
  </body>
</html>